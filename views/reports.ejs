<%- include('partials/header') %>
<h1 class="mb-4 text-xl font-bold text-gray-800">รายงานสรุป</h1>

<form method="get" class="card mb-4 space-y-3">
  <div>
    <label class="field-label" for="start">จากวันที่</label>
    <input class="field-input" type="date" id="start" name="start" value="<%= start %>">
  </div>
  <div>
    <label class="field-label" for="end">ถึงวันที่</label>
    <input class="field-input" type="date" id="end" name="end" value="<%= end %>">
  </div>
  <div>
    <label class="field-label" for="room">ห้อง/สาขา</label>
    <select class="field-input" id="room" name="room">
      <option value="">ทุกห้อง</option>
      <% rooms.forEach(function(r) { %>
      <option value="<%= r %>" <%= r === room ? 'selected' : '' %>><%= r %></option>
      <% }) %>
    </select>
  </div>
  <div class="flex gap-2">
    <button type="submit" class="btn-primary flex-1">แสดงรายงาน</button>
    <a class="btn-secondary flex-1" href="/api/reports/export?start=<%= start %>&end=<%= end %>&room=<%= encodeURIComponent(room) %>">ดาวน์โหลด CSV</a>
  </div>
</form>

<div class="card overflow-x-auto p-0">
  <table class="w-full min-w-[560px] text-sm">
    <thead>
      <tr class="border-b border-gray-200 bg-gray-50 text-left text-xs font-semibold uppercase tracking-wide text-gray-500">
        <th class="px-3 py-2">รหัส</th>
        <th class="px-3 py-2">ชื่อ-สกุล</th>
        <th class="px-3 py-2">ห้อง</th>
        <th class="px-3 py-2 text-center">มา</th>
        <th class="px-3 py-2 text-center">สาย</th>
        <th class="px-3 py-2 text-center">ขาด</th>
        <th class="px-3 py-2 text-center">แต่งกายไม่ผ่าน</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-100">
      <% summary.forEach(function(row) { %>
      <tr>
        <td class="px-3 py-2"><%= row.student_code %></td>
        <td class="px-3 py-2 font-medium text-gray-800"><%= row.full_name %></td>
        <td class="px-3 py-2 text-gray-500"><%= row.class_room %></td>
        <td class="px-3 py-2 text-center"><%= row.present_count || 0 %></td>
        <td class="px-3 py-2 text-center"><%= row.late_count || 0 %></td>
        <td class="px-3 py-2 text-center"><%= row.absent_count || 0 %></td>
        <td class="px-3 py-2 text-center"><%= row.uniform_fail_count || 0 %></td>
      </tr>
      <% }) %>
    </tbody>
  </table>
</div>
<%- include('partials/footer') %>
