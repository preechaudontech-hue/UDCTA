<%- include('partials/header') %>
<h1 class="mb-4 text-xl font-bold text-gray-800">ผลการเรียนเฉลี่ย (GPA)</h1>

<form method="get" class="card mb-4 space-y-3">
  <div>
    <label class="field-label" for="term">ภาคเรียน</label>
    <input class="field-input" type="text" id="term" name="term" value="<%= term %>" placeholder="เช่น 1/2569">
  </div>
  <div>
    <label class="field-label" for="room">ห้อง/สาขา</label>
    <select class="field-input" id="room" name="room" onchange="this.form.submit()">
      <option value="">-- เลือกห้อง --</option>
      <% rooms.forEach(function(r) { %>
      <option value="<%= r %>" <%= r === room ? 'selected' : '' %>><%= r %></option>
      <% }) %>
    </select>
  </div>
  <% if (room) { %>
  <div>
    <label class="field-label" for="student_id">นักเรียน</label>
    <select class="field-input" id="student_id" name="student_id">
      <option value="">-- เลือกนักเรียน --</option>
      <% students.forEach(function(s) { %>
      <option value="<%= s.id %>" <%= student && student.id === s.id ? 'selected' : '' %>><%= s.student_code %> — <%= s.full_name %></option>
      <% }) %>
    </select>
  </div>
  <% } %>
  <button type="submit" class="btn-secondary w-full">โหลดข้อมูล</button>
  <a href="/grades/summary?room=<%= encodeURIComponent(room) %>&term=<%= encodeURIComponent(term) %>" class="block text-center text-sm text-brand underline">ดูสรุป GPA ทั้งห้อง</a>
</form>

<% if (student) { %>
<div class="card space-y-4" id="grades-form" data-student-id="<%= student.id %>" data-term="<%= term %>">
  <div>
    <p class="font-semibold text-gray-800"><%= student.full_name %></p>
    <p class="text-xs text-gray-500">รหัส <%= student.student_code %> — ภาคเรียน <%= term %></p>
  </div>

  <table class="w-full text-sm" id="subjects-table">
    <thead>
      <tr class="border-b border-gray-200 text-left text-xs font-semibold uppercase tracking-wide text-gray-500">
        <th class="py-2">รายวิชา</th>
        <th class="w-20 py-2 text-center">หน่วยกิต</th>
        <th class="w-24 py-2 text-center">เกรด</th>
        <th class="w-8 py-2"></th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-100">
      <% subjects.forEach(function(s) { %>
      <tr class="subject-row">
        <td class="py-1.5 pr-1"><input type="text" class="field-input subject-name" value="<%= s.subject_name %>" placeholder="ชื่อวิชา"></td>
        <td class="py-1.5 px-1"><input type="number" step="0.5" min="0" class="field-input credit-hours text-center" value="<%= s.credit_hours %>"></td>
        <td class="py-1.5 px-1">
          <select class="field-input grade-point text-center">
            <% gradePoints.forEach(function(g) { %>
            <option value="<%= g %>" <%= Number(s.grade_point) === g ? 'selected' : '' %>><%= g.toFixed(1) %></option>
            <% }) %>
          </select>
        </td>
        <td class="py-1.5 text-center"><button type="button" class="remove-row text-rose-500">✕</button></td>
      </tr>
      <% }) %>
    </tbody>
  </table>

  <button type="button" id="add-row-btn" class="btn-secondary w-full">+ เพิ่มรายวิชา</button>

  <div class="flex items-center justify-between rounded-lg bg-brand-light px-4 py-3">
    <span class="text-sm font-medium text-gray-700">เกรดเฉลี่ย (GPA)</span>
    <span id="gpa-display" class="text-2xl font-bold text-brand">-</span>
  </div>

  <div id="save-status" class="text-sm font-medium"></div>
  <button type="button" id="save-grades-btn" class="btn-primary w-full">บันทึกผลการเรียน</button>
</div>
<% } else if (room) { %>
<p class="rounded-lg bg-gray-100 p-3 text-sm text-gray-600">เลือกนักเรียนแล้วกด "โหลดข้อมูล" เพื่อเริ่มกรอกเกรด</p>
<% } %>

<template id="subject-row-template">
  <tr class="subject-row">
    <td class="py-1.5 pr-1"><input type="text" class="field-input subject-name" placeholder="ชื่อวิชา"></td>
    <td class="py-1.5 px-1"><input type="number" step="0.5" min="0" class="field-input credit-hours text-center" value="1"></td>
    <td class="py-1.5 px-1">
      <select class="field-input grade-point text-center">
        <% gradePoints.forEach(function(g) { %>
        <option value="<%= g %>" <%= g === 3 ? 'selected' : '' %>><%= g.toFixed(1) %></option>
        <% }) %>
      </select>
    </td>
    <td class="py-1.5 text-center"><button type="button" class="remove-row text-rose-500">✕</button></td>
  </tr>
</template>

<script src="/grades.js"></script>
<%- include('partials/footer') %>
